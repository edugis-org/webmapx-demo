dist-lib
dist/
node_modules/
demo/config/apikeys.json

# Configs and the styles they read live in edugis-org/webmapx-configs. The build
# fetches them at the commit webmapx pins in configs.lock; a copy kept here
# would be the stale fork this repo already had once (see NOTES.md).
config/
styles/

# Also assembled at build time, from the pinned webmapx build rather than from
# here: the bundled preview host the tool-doc pages embed, and the hashed assets
# it loads. Symlink them to a sibling `webmapx/dist` to work on the pages
# locally (`npm run build` there first). `dist-lib/` above is the same:
# symlink it to a sibling `webmapx/dist-lib` (`npm run build:lib` there), or a
# stale copy makes `build:tool-docs` report a newly added tool as "not in the
# registry" — the workflow points WEBMAPX_DIST_LIB at the pinned build instead.
/testpages
/assets

# Generated by `npm run build:tool-docs` from docs/tools/*.md plus the tool
# registry of the pinned webmapx build. Regenerated by the workflow, so a copy
# here could only ever describe a different version than the one deployed.
/tools/
/llms.txt
